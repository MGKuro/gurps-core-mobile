static func get_damage_dice(st: int, is_swing: bool = false) -> Dictionary:
	var extra_dices: int
	
	if st > 100:
		extra_dices = floor(st - 100)/10
		if is_swing:
			return {"dices": 13 + extra_dices, "mod": 0}
		else:
			return {"dices": 11 + extra_dices, "mod": 0}
			
	else:
		st = clamp(st, 1, 100)
		var attack_type = "swing" if is_swing else "thrust"
		return DAMAGE_TABLE[st][attack_type]
